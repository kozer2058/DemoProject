--- !u!114 &918424967
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 918424965}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sau nhi\u1EC1u n\u0103m nghi\xEAn c\u1EE9u, nh\xE2n lo\u1EA1i ph\xE1t
    hi\u1EC7n r\u1EB1ng nh\u1EEFng linh h\u1ED3n ph\xF9 h\u1EE3p c\xF3 th\u1EC3 c\u1ED9ng
    h\u01B0\u1EDFng v\u1EDBi nhau. Ch\xEDn linh h\u1ED3n \u0111\u01B0\u1EE3c n\u1EA1p
    theo \u0111\xFAng c\xF4ng th\u1EE9c s\u1EBD t\xE1i c\u1EA5u tr\xFAc tr\u1EE5
    ph\xF2ng th\u1EE7, t\u1EA1o ra Flame, Frost, Storm ho\u1EB7c Sonic Resonance.\n\nM\u1ED7i
    c\u1ED9ng h\u01B0\u1EDFng s\u1EDF h\u1EEFu m\u1ED9t c\xE1ch t\u1EA5n c\xF4ng
    ri\xEAng: thi\xEAu ch\xE1y, \u0111\xF3ng b\u0103ng, ph\xF3ng \u0111i\u1EC7n ho\u1EB7c
    t\u1EA1o s\xF3ng xung k\xEDch. Nh\u01B0ng n\u1EBFu ch\xEDn linh h\u1ED3n kh\xF4ng
    th\u1EC3 c\u1ED9ng h\u01B0\u1EDFng, \xFD th\u1EE9c c\xF2n s\xF3t l\u1EA1i b\xEAn
    trong ch\xFAng s\u1EBD chi\u1EBFm quy\u1EC1n \u0111i\u1EC1u khi\u1EC3n c\u1ED7
    m\xE1y.\n\nKhi \u0111\xF3, tr\u1EE5 ph\xF2ng th\u1EE7 s\u1EBD kh\xF4ng c\xF2n
    b\u1EA3o v\u1EC7 Soul Core. N\xF3 s\u1EBD tr\u1EDF th\xE0nh m\u1ED9t sinh v\u1EADt
    m\u1EDBi v\xE0 quay v\u0169 kh\xED v\u1EC1 ph\xEDa ng\u01B0\u1EDDi \u0111\xE3
    t\u1EA1o ra n\xF3."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
