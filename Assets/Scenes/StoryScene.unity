  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "N\u0103ng l\u01B0\u1EE3ng t\u1EEBng l\xE0 th\u1EE9 gi\xFAp nh\xE2n lo\u1EA1i
    ch\u1EA1m t\u1EDBi c\xE1c v\xEC sao. Nh\u01B0ng sau nhi\u1EC1u th\u1EADp k\u1EF7
    khai th\xE1c kh\xF4ng ki\u1EC3m so\xE1t, nh\u1EEFng m\u1ECF nhi\xEAn li\u1EC7u
    cu\u1ED1i c\xF9ng \u0111\xE3 c\u1EA1n ki\u1EC7t. C\xE1c th\xE0nh ph\u1ED1 ch\xECm
    d\u1EA7n v\xE0o b\xF3ng t\u1ED1i, m\u1EA1ng l\u01B0\u1EDBi \u0111i\u1EC7n ch\u1EC9
    c\xF2n ho\u1EA1t \u0111\u1ED9ng v\xE0i gi\u1EDD m\u1ED7i ng\xE0y v\xE0 nh\u1EEFng
    cu\u1ED9c chi\u1EBFn tranh gi\xE0nh t\xE0i nguy\xEAn b\u1EAFt \u0111\u1EA7u lan
    r\u1ED9ng.\n\nKhi n\u1EC1n v\u0103n minh \u0111\u1EE9ng tr\u01B0\u1EDBc nguy
    c\u01A1 s\u1EE5p \u0111\u1ED5, Li\xEAn Minh \u0110\u1ECBa C\u1EA7u kh\u1EDFi
    \u0111\u1ED9ng ch\u01B0\u01A1ng tr\xECnh th\u0103m d\xF2 kh\xF4ng gian cu\u1ED1i
    c\xF9ng. H\xE0ng ngh\xECn t\xE0u d\xF2 \u0111\u01B0\u1EE3c ph\xF3ng v\xE0o v\xF9ng
    t\u1ED1i, mang theo hy v\u1ECDng mong manh r\u1EB1ng \u1EDF \u0111\xE2u \u0111\xF3
    ngo\xE0i kia v\u1EABn t\u1ED3n t\u1EA1i m\u1ED9t ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng
    c\xF3 th\u1EC3 c\u1EE9u l\u1EA5y nh\xE2n lo\u1EA1i."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
