  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "T\xE0u v\u1EADn chuy\u1EC3n \u0111\xE3 m\u1EA5t li\xEAn l\u1EA1c v\xE0
    kh\xF4ng c\xF2n c\u1EEDa s\u1ED5 s\u01A1 t\xE1n. Soul Core v\u1EABn \u0111ang
    truy\u1EC1n d\u1EEF li\u1EC7u v\u1EC1 Tr\xE1i \u0110\u1EA5t, nh\u01B0ng kh\xF4ng
    ai bi\u1EBFt t\xEDn hi\u1EC7u c\xF3 th\u1EC3 duy tr\xEC trong bao l\xE2u.\n\nM\u1ED7i
    gi\xE2y b\u1EA1n s\u1ED1ng s\xF3t, m\u1ED7i sinh v\u1EADt b\u1ECB ti\xEAu di\u1EC7t
    v\xE0 m\u1ED7i \u0111\u1EE3t t\u1EA5n c\xF4ng b\u1ECB \u0111\u1EA9y l\xF9i s\u1EBD
    cung c\u1EA5p th\xEAm d\u1EEF li\u1EC7u cho nh\u1EEFng Warden ti\u1EBFp theo.\n\nKh\xF4ng
    c\xF3 chi\u1EBFn th\u1EAFng cu\u1ED1i c\xF9ng trong nhi\u1EC7m v\u1EE5 n\xE0y.
    Ch\u1EC9 c\xF3 th\u1EDDi gian, \u0111i\u1EC3m s\u1ED1 v\xE0 gi\u1EDBi h\u1EA1n
    c\u1EE7a ch\xEDnh b\u1EA1n.\n\nH\xE3y \u0111\u1EE9ng v\u1EEFng l\xE2u nh\u1EA5t
    c\xF3 th\u1EC3."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
