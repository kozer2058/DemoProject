  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Soul Energy kh\xF4ng ch\u1EC9 t\u1ED3n t\u1EA1i trong l\xF2ng \u0111\u1EA5t.
    N\xF3 \u0111\xE3 th\u1EA5m v\xE0o h\u1EC7 sinh th\xE1i c\u1EE7a Nox-7 su\u1ED1t
    h\xE0ng tri\u1EC7u n\u0103m. Khi Soul Core b\u1EAFt \u0111\u1EA7u khai th\xE1c,
    c\xE2n b\u1EB1ng c\u1EE7a h\xE0nh tinh b\u1ECB ph\xE1 v\u1EE1 v\xE0 c\xE1c sinh
    v\u1EADt b\u1EA3n \u0111\u1ECBa bi\u1EBFn \u0111\u1ED5i th\xE0nh nh\u1EEFng c\u1ED7
    m\xE1y s\u0103n m\u1ED3i kh\u1ED5ng l\u1ED3.\n\nM\u1ED7i sinh v\u1EADt b\u1ECB
    ti\xEAu di\u1EC7t \u0111\u1EC3 l\u1EA1i m\u1ED9t m\u1EA3nh linh h\u1ED3n mang
    \u0111\u1EB7c t\xEDnh ri\xEAng: Speed, Power ho\u1EB7c Defense. Nh\u1EEFng m\u1EA3nh
    linh h\u1ED3n c\xF3 th\u1EC3 \u0111\u01B0\u1EE3c h\xFAt v\xE0o v\u0169 kh\xED
    c\u1EE7a Warden, sau \u0111\xF3 n\u1EA1p v\xE0o c\xE1c tr\u1EE5 ph\xF2ng th\u1EE7.\n\nNh\u01B0ng
    linh h\u1ED3n kh\xF4ng ph\u1EA3i ngu\u1ED3n nhi\xEAn li\u1EC7u b\xECnh th\u01B0\u1EDDng.
    Ch\xFAng v\u1EABn c\xF2n ghi nh\u1EDB b\u1EA3n n\u0103ng c\u1EE7a v\u1EADt ch\u1EE7
    c\u0169."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
