--- !u!114 &1014059973
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1014059971}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sau nhi\u1EC1u n\u0103m im l\u1EB7ng, m\u1ED9t t\xE0u d\xF2 g\u1EEDi v\u1EC1
    t\xEDn hi\u1EC7u t\u1EEB h\xE0nh tinh Nox-7. B\xEAn d\u01B0\u1EDBi b\u1EC1 m\u1EB7t
    hoang t\xE0n c\u1EE7a n\xF3 t\u1ED3n t\u1EA1i nh\u1EEFng m\u1EA1ch tinh th\u1EC3
    ph\xE1t ra n\u0103ng l\u01B0\u1EE3ng m\u1EA1nh h\u01A1n b\u1EA5t k\u1EF3 nhi\xEAn
    li\u1EC7u n\xE0o t\u1EEBng \u0111\u01B0\u1EE3c bi\u1EBFt \u0111\u1EBFn.\n\nNgu\u1ED3n
    n\u0103ng l\u01B0\u1EE3ng m\u1EDBi \u0111\u01B0\u1EE3c \u0111\u1EB7t t\xEAn l\xE0
    Soul Energy v\xEC n\xF3 ph\u1EA3n \u1EE9ng nh\u01B0 m\u1ED9t sinh v\u1EADt s\u1ED1ng:
    dao \u0111\u1ED9ng, th\xEDch nghi v\xE0 ghi nh\u1EDB nh\u1EEFng v\u1EADt th\u1EC3
    t\u1EEBng ti\u1EBFp x\xFAc v\u1EDBi n\xF3. C\xE1c tr\u1EA1m khai th\xE1c t\u1EF1
    \u0111\u1ED9ng \u0111\u1EA7u ti\xEAn \u0111\u01B0\u1EE3c tri\u1EC3n khai, nh\u01B0ng
    ch\u1EC9 v\xE0i ng\xE0y sau, to\xE0n b\u1ED9 t\xEDn hi\u1EC7u bi\u1EBFn m\u1EA5t.\n\nH\xECnh
    \u1EA3nh cu\u1ED1i c\xF9ng cho th\u1EA5y c\xE1c sinh v\u1EADt b\u1EA3n \u0111\u1ECBa
    \u0111ang ti\u1EBFn v\u1EC1 ph\xEDa tr\u1EA1m khai th\xE1c."
